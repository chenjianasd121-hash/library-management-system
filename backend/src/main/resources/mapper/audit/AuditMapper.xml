<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.library.management.audit.mapper.AuditMapper">
 <insert id="insert">INSERT INTO audit_logs(actor_id,action,entity_type,entity_id,before_json,after_json,trace_id,occurred_at) VALUES(#{actorId},#{action},#{entityType},#{entityId},#{beforeJson},#{afterJson},#{traceId},UTC_TIMESTAMP(3))</insert>
 <sql id="filter"><where><if test="action != null and action != ''">AND a.action=#{action}</if><if test="actorId != null">AND a.actor_id=#{actorId}</if><if test="from != null and from != ''">AND a.occurred_at &gt;= #{from}</if><if test="to != null and to != ''">AND a.occurred_at &lt;= #{to}</if></where></sql>
 <select id="list" resultType="com.library.management.common.DbRecord">SELECT a.id,a.actor_id,u.display_name actor_name,a.action,a.entity_type,a.entity_id,a.trace_id,a.occurred_at FROM audit_logs a LEFT JOIN users u ON u.id=a.actor_id <include refid="filter"/> ORDER BY a.occurred_at DESC,a.id DESC LIMIT #{size} OFFSET #{offset}</select>
 <select id="count" resultType="long">SELECT COUNT(*) FROM audit_logs a <include refid="filter"/></select>
</mapper>
