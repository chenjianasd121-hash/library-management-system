{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode reader --host 127.0.0.1 --port 5173 --strictPort",
    "dev:reader": "vite --mode reader --host 127.0.0.1 --port 5173 --strictPort",
    "dev:librarian": "vite --mode librarian --host 127.0.0.2 --port 5174 --strictPort",
    "dev:admin": "vite --mode admin --host 127.0.0.3 --port 5175 --strictPort",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:flow:browser": "node tests/flow-qa/browser.mjs && node tests/flow-qa/browser-edges.mjs && node tests/flow-qa/browser-management.mjs",
    "test:flow:api": "node tests/flow-qa/api-edges.mjs && node tests/flow-qa/lifecycle-extra.mjs",
    "test:flow:concurrency": "node tests/flow-qa/concurrency.mjs",
    "test:flow:stress": "node tests/flow-qa/stress.mjs",
    "qa:visual:prepare": "node tests/visual-acceptance.mjs --prepare",
    "qa:visual:capture": "node tests/visual-acceptance.mjs",
    "qa:visual:viewer": "node tests/visual-acceptance-viewer.mjs",
    "qa:visual:compare": "node tests/visual-acceptance-compare.mjs",
    "build-only": "vite build",
    "build:reader": "vite build --mode reader --outDir dist/reader",
    "build:librarian": "vite build --mode librarian --outDir dist/librarian",
    "build:admin": "vite build --mode admin --outDir dist/admin",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.6",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "playwright-core": "^1.63.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
